# SportScore environment variables.
#
# Copy this file to `.env` for local development. In production (Render) set
# these in the service's Environment tab instead — real env vars win over .env.
#
# Security note: NEVER commit the real `.env` (it's gitignored).

# ---- Core ------------------------------------------------------------------

# Public URL of the deployment. Used for Google OAuth redirects and any
# absolute links in emails. For the Render subdomain:
#   BASE_URL=https://sportscore.onrender.com
BASE_URL=http://localhost:4321

# HTTP + WebSocket port. Render injects `PORT` automatically.
PORT=4321

# Node should be production so DEV_CODES is ignored and real emails send.
# (Render sets NODE_ENV=production by default.)
NODE_ENV=development

# ---- Persistence -----------------------------------------------------------

# Root directory for the SQLite database and avatar uploads.
# On Render: set DATA_DIR=/data (the persistent disk mount) and upgrade to a
# paid plan — free plans have an ephemeral filesystem that is wiped on deploy.
DATA_DIR=./data

# Full path override for the SQLite file (optional; defaults to DATA_DIR/sportscore.db).
# DATABASE_PATH=/data/sportscore.db

# ---- Email (Resend) --------------------------------------------------------
# https://resend.com — create an API key and verify a sending domain.
# A verified sender such as: SportScore <score@sportscore.app>
RESEND_API_KEY=
EMAIL_FROM=SportScore <onboarding@resend.dev>

# Local-only hack: set to 1 to show verification codes on screen instead of
# sending emails. ALWAYS 0 in production (or just rely on NODE_ENV=production).
DEV_CODES=0

# ---- Google sign-in (optional) ---------------------------------------------
# https://console.cloud.google.com -> OAuth consent screen + OAuth client ID.
# Authorized redirect URI must be: <BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Error tracking (optional) ---------------------------------------------
# Create a free project at https://sentry.io. DSN goes to backend crashes and
# HTTP/WS errors; SENTRY_CLIENT_KEY (the public key) is embedded in the page for
# browser crashes. Leave blank to disable (safe no-op).
SENTRY_DSN=
SENTRY_CLIENT_KEY=
